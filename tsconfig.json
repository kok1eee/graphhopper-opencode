{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "types": ["bun-types", "node"]
  },
  "include": ["src/**/*.ts", ".opencode/plugins/**/*.ts", ".opencode/plugins/**/*.tsx"]
}
